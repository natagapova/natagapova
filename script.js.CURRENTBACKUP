  };

  const outerBlur = parseFloat(styles.getPropertyValue("--lang-glow-blur-outer"));
  const innerBlur = parseFloat(styles.getPropertyValue("--lang-glow-blur-inner"));
  langGlowBlur = {
    outer: Number.isFinite(outerBlur) ? outerBlur : 8,
