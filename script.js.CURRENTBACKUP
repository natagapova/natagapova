      if (lightboxOpen) {
        closeProjectLightbox();
        return;
      }
      if (openProjectId) closeProjectOverlay();
      return;
    }

    if (!lightboxOpen) return;

    if (event.key === "ArrowLeft") {
      event.preventDefault();
      stepProjectLightbox(-1);
    } else if (event.key === "ArrowRight") {
      event.preventDefault();
      stepProjectLightbox(1);
    }
  });
}

