const PERSON_VIDEO_EXT = /\.(mov|mp4|webm|m4v)$/i;
const PERSON_COLUMN_HEIGHT_TOLERANCE = 4;
const PERSON_COLUMN_TRIM_STEP = 6;

let personGalleryFiles = null;
let personGalleryResizeFrame = 0;
let personLightboxIndex = 0;
let personLightboxItems = [];

function shuffleArray(items) {
  const arr = [...items];
  for (let i = arr.length - 1; i > 0; i -= 1) {
    const j = Math.floor(Math.random() * (i + 1));
    [arr[i], arr[j]] = [arr[j], arr[i]];
  }
  return arr;
}

function getPersonColumnCount() {
  if (window.matchMedia("(max-width: 380px)").matches) return 1;
  if (window.matchMedia("(max-width: 620px)").matches) return 2;
  if (window.matchMedia("(max-width: 900px)").matches) return 3;
  return 4;
}

function isPersonVideo(filename) {
  return PERSON_VIDEO_EXT.test(filename);
}

function personMediaSrc(filename) {
  return `${PERSON_MEDIA_DIR}/${filename.split("/").map(encodeURIComponent).join("/")}`;
}

function loadPersonMediaAspect(filename) {
  const src = personMediaSrc(filename);

  if (isPersonVideo(filename)) {
    return new Promise((resolve) => {
      const video = document.createElement("video");
      video.preload = "metadata";
      video.onloadedmetadata = () => {
        const width = video.videoWidth || 16;
        const height = video.videoHeight || 9;
        resolve(height / width);
      };
      video.onerror = () => resolve(16 / 9);
      video.src = src;
    });
  }

  return new Promise((resolve) => {
    const image = new Image();
    image.onload = () => {
      const width = image.naturalWidth || 1;
      const height = image.naturalHeight || 1;
      resolve(height / width);
    };
    image.onerror = () => resolve(1);
    image.src = src;
  });
}

function balancePersonMedia(files, aspects, columnCount) {
  const columns = Array.from({ length: columnCount }, () => []);
  const heights = Array(columnCount).fill(0);

  for (let index = 0; index < files.length; index += 1) {
    let targetColumn = 0;
    for (let column = 1; column < columnCount; column += 1) {
      if (heights[column] < heights[targetColumn]) {
        targetColumn = column;
      }
    }
    columns[targetColumn].push(files[index]);
    heights[targetColumn] += aspects[index];
  }

  return columns;
}

function renderPersonMediaItem(filename, index) {
  const src = personMediaSrc(filename);
  const openLabel = formatSiteText(
    translations[currentLang]?.personMediaOpen ?? "Open"
  );

  if (isPersonVideo(filename)) {
    return `
      <figure class="person-gallery__item" role="listitem">
        <button
          type="button"
          class="person-gallery__open"
          data-person-lightbox-index="${index}"
          aria-label="${openLabel}"
        >
          <div class="person-gallery__crop">
            <video
              class="person-gallery__media"
              src="${src}"
              autoplay
              muted
              loop
              playsinline
              preload="metadata"
              aria-hidden="true"
            ></video>
          </div>
        </button>
      </figure>
    `;
  }

  return `
    <figure class="person-gallery__item" role="listitem">
      <button
        type="button"
        class="person-gallery__open"
        data-person-lightbox-index="${index}"
        aria-label="${openLabel}"
      >
        <div class="person-gallery__crop">
          <img
            class="person-gallery__media"
            src="${src}"
            alt=""
            loading="eager"
            decoding="async"
          />
        </div>
      </button>
    </figure>
  `;
}

function renderPersonGalleryColumns(columns) {
  return columns
    .map(
      (files) => `
        <div class="person-gallery__column" role="presentation">
          ${files
            .map((filename) =>
              renderPersonMediaItem(filename, personGalleryFiles.indexOf(filename))
            )
            .join("")}
        </div>
      `
    )
    .join("");
}

function waitForPersonGalleryMedia(gallery) {
  const media = [...gallery.querySelectorAll(".person-gallery__media")];

  return Promise.all(
    media.map(
      (element) =>
        new Promise((resolve) => {
          const finish = () => resolve();
          const timeout = window.setTimeout(finish, 4000);

          const done = () => {
            window.clearTimeout(timeout);
            finish();
          };

          if (element instanceof HTMLImageElement) {
            if (element.complete) {
              done();
              return;
            }
            element.addEventListener("load", done, { once: true });
            element.addEventListener("error", done, { once: true });
            return;
          }

          if (element instanceof HTMLVideoElement) {
            if (element.readyState >= 1) {
              done();
              return;
            }
            element.addEventListener("loadedmetadata", done, { once: true });
            element.addEventListener("error", done, { once: true });
            return;
          }

          done();
        })
    )
  );
}

function preparePersonCropForTrim(crop) {
  if (crop.dataset.trimReady === "1") return;

  const media = crop.querySelector(".person-gallery__media");
  if (!media) return;

  const height = media.getBoundingClientRect().height;
  if (height <= 0) return;

  crop.dataset.trimReady = "1";
  crop.dataset.maxHeight = String(height);
  crop.style.height = `${height}px`;
  crop.classList.add("person-gallery__crop--trimmed");
}

function trimPersonCrop(crop, amount) {
  const current = Number.parseFloat(crop.style.height) || crop.getBoundingClientRect().height;
  const maxHeight = Number.parseFloat(crop.dataset.maxHeight) || current;
  const minHeight = Math.max(56, maxHeight * 0.72);
  const next = Math.max(minHeight, current - amount);
  crop.style.height = `${next}px`;
}

function equalizePersonColumnHeights(gallery) {
  const columns = [...gallery.querySelectorAll(".person-gallery__column")];
  if (columns.length <= 1) return;

  const maxIterations = 240;

  for (let iteration = 0; iteration < maxIterations; iteration += 1) {
    const heights = columns.map((column) => column.getBoundingClientRect().height);
    const minHeight = Math.min(...heights);
    const maxHeight = Math.max(...heights);

    if (maxHeight - minHeight <= PERSON_COLUMN_HEIGHT_TOLERANCE) break;

    const tallColumnIndex = heights.indexOf(maxHeight);
    const tallColumn = columns[tallColumnIndex];
    const items = [...tallColumn.querySelectorAll(".person-gallery__item")];
    if (!items.length) break;

    const tallestItem = items.reduce((largest, item) =>
      item.getBoundingClientRect().height > largest.getBoundingClientRect().height ? item : largest
    );
    const crop = tallestItem.querySelector(".person-gallery__crop");
    if (!crop) break;

    preparePersonCropForTrim(crop);
    trimPersonCrop(crop, Math.min(PERSON_COLUMN_TRIM_STEP, maxHeight - minHeight));
  }
}

async function renderPersonGallery({ reshuffle = true } = {}) {
  const gallery = document.getElementById("person-gallery");
  if (!gallery) return;

  try {
    const response = await fetch(`${PERSON_MEDIA_DIR}/manifest.json`);
    if (!response.ok) return;
    const files = await response.json();
    if (!Array.isArray(files) || !files.length) return;

    if (reshuffle || !personGalleryFiles) {
      personGalleryFiles = shuffleArray(files.filter(Boolean));
    }

    gallery.classList.add("person-gallery--loading");

    const aspects = await Promise.all(personGalleryFiles.map((filename) => loadPersonMediaAspect(filename)));
    const columns = balancePersonMedia(personGalleryFiles, aspects, getPersonColumnCount());

    personLightboxItems = [...personGalleryFiles];

    gallery.innerHTML = renderPersonGalleryColumns(columns);
    gallery.dataset.columns = String(columns.length);

    await waitForPersonGalleryMedia(gallery);
    equalizePersonColumnHeights(gallery);
  } catch {
    gallery.innerHTML = "";
  } finally {
    gallery.classList.remove("person-gallery--loading");
    updatePersonLightboxLabels(translations[currentLang]);
  }
}

function schedulePersonGalleryLayout({ reshuffle = false } = {}) {
  cancelAnimationFrame(personGalleryResizeFrame);
  personGalleryResizeFrame = requestAnimationFrame(() => {
    renderPersonGallery({ reshuffle });
  });
}

function applyPersonPage(t) {
  const titleEl = document.getElementById("person-page-title");

  if (titleEl && t.personPageTitle) {
    titleEl.textContent = formatSiteText(t.personPageTitle);
  }

  updatePersonLightboxLabels(t);
  renderPersonGallery({ reshuffle: true });
}

function resetPersonLightboxVideo(video) {
  if (!video) return;
  video.pause();
  video.removeAttribute("src");
  video.load();
  video.hidden = true;
}

function closePersonLightbox() {
  const lightbox = document.getElementById("person-lightbox");
  if (!lightbox || lightbox.hidden) return;

  lightbox.hidden = true;
  document.body.classList.remove("is-person-lightbox-open");

  const img = document.getElementById("person-lightbox-image");
  const video = document.getElementById("person-lightbox-video");

  if (img) {
    img.removeAttribute("src");
    img.hidden = true;
    img.classList.remove("is-loading");
  }

  resetPersonLightboxVideo(video);
}

async function updatePersonLightboxMedia() {
  const lightbox = document.getElementById("person-lightbox");
  const img = document.getElementById("person-lightbox-image");
  const video = document.getElementById("person-lightbox-video");
  const counter = document.getElementById("person-lightbox-counter");
  const prevBtn = document.getElementById("person-lightbox-prev");
  const nextBtn = document.getElementById("person-lightbox-next");
  if (!lightbox || lightbox.hidden || !personLightboxItems.length) return;

  const count = personLightboxItems.length;
  const filename = personLightboxItems[personLightboxIndex];
  const src = personMediaSrc(filename);

  if (isPersonVideo(filename)) {
    if (img) {
      img.removeAttribute("src");
      img.hidden = true;
      img.classList.remove("is-loading");
    }

    if (video) {
      resetPersonLightboxVideo(video);
      video.hidden = false;
      video.src = src;
      video.muted = true;
      video.loop = true;
      video.playsInline = true;
      try {
        await video.play();
      } catch {
        /* autoplay may be blocked until user interacts */
      }
    }
  } else if (img) {
    resetPersonLightboxVideo(video);
    img.hidden = false;
    img.classList.add("is-loading");
    await preloadLightboxSrc(src);
    img.src = src;
    img.classList.remove("is-loading");
  }

  if (counter) {
    counter.textContent = count > 1 ? `${personLightboxIndex + 1} / ${count}` : "";
    counter.hidden = count <= 1;
  }

  const hideNav = count <= 1;
  if (prevBtn) prevBtn.hidden = hideNav;
  if (nextBtn) nextBtn.hidden = hideNav;
}

async function openPersonLightbox(index) {
  const lightbox = document.getElementById("person-lightbox");
  if (!lightbox || !personLightboxItems.length) return;

  personLightboxIndex =
    ((index % personLightboxItems.length) + personLightboxItems.length) %
    personLightboxItems.length;

  lightbox.hidden = false;
  document.body.classList.add("is-person-lightbox-open");
  await updatePersonLightboxMedia();

  const closeBtn = document.getElementById("person-lightbox-close");
  closeBtn?.focus({ preventScroll: true });
}

async function stepPersonLightbox(delta) {
  if (!personLightboxItems.length) return;
  personLightboxIndex =
    (personLightboxIndex + delta + personLightboxItems.length) % personLightboxItems.length;
  await updatePersonLightboxMedia();
}

function updatePersonLightboxLabels(t) {
  const lightbox = document.getElementById("person-lightbox");
  const lightboxDialog = lightbox?.querySelector(".person-lightbox__dialog");
  const lightboxClose = document.getElementById("person-lightbox-close");
  const lightboxBackdrop = document.getElementById("person-lightbox-backdrop");
  const lightboxPrev = document.getElementById("person-lightbox-prev");
  const lightboxNext = document.getElementById("person-lightbox-next");

  if (lightboxDialog && t.projectLightboxLabel) {
    lightboxDialog.setAttribute("aria-label", formatSiteText(t.projectLightboxLabel));
  }
  if (lightboxClose && t.closeProject) {
    lightboxClose.setAttribute("aria-label", formatSiteText(t.closeProject));
  }
  if (lightboxBackdrop && t.closeProject) {
    lightboxBackdrop.setAttribute("aria-label", formatSiteText(t.closeProject));
  }
  if (lightboxPrev && t.projectLightboxPrev) {
    lightboxPrev.setAttribute("aria-label", formatSiteText(t.projectLightboxPrev));
  }
  if (lightboxNext && t.projectLightboxNext) {
    lightboxNext.setAttribute("aria-label", formatSiteText(t.projectLightboxNext));
  }

  document.querySelectorAll(".person-gallery__open[data-person-lightbox-index]").forEach((button) => {
    if (t.personMediaOpen) {
      button.setAttribute("aria-label", formatSiteText(t.personMediaOpen));
    }
  });
}

function initPersonLightbox() {
  const gallery = document.getElementById("person-gallery");
  const lightbox = document.getElementById("person-lightbox");
  if (!gallery || !lightbox || gallery.dataset.lightboxBound === "true") return;

  gallery.dataset.lightboxBound = "true";

  const lightboxBackdrop = document.getElementById("person-lightbox-backdrop");
  const lightboxClose = document.getElementById("person-lightbox-close");
  const lightboxPrev = document.getElementById("person-lightbox-prev");
  const lightboxNext = document.getElementById("person-lightbox-next");

  gallery.addEventListener("click", (event) => {
    const openBtn = event.target.closest(".person-gallery__open");
    if (!openBtn) return;
    event.preventDefault();
    const index = Number.parseInt(openBtn.dataset.personLightboxIndex ?? "", 10);
    if (Number.isNaN(index)) return;
    void openPersonLightbox(index);
  });

  lightboxBackdrop?.addEventListener("click", closePersonLightbox);
  lightboxClose?.addEventListener("click", closePersonLightbox);
  lightboxPrev?.addEventListener("click", () => stepPersonLightbox(-1));
  lightboxNext?.addEventListener("click", () => stepPersonLightbox(1));

  document.addEventListener("keydown", (event) => {
    const lightboxOpen = lightbox && !lightbox.hidden && personLightboxItems.length > 0;
    if (!lightboxOpen) return;

    if (event.key === "Escape") {
      closePersonLightbox();
      return;
    }

    if (event.key === "ArrowLeft") {
      event.preventDefault();
      stepPersonLightbox(-1);
    } else if (event.key === "ArrowRight") {
      event.preventDefault();
      stepPersonLightbox(1);
    }
  });
}

