  backdrop?.addEventListener("click", closeProjectOverlay);

  gallery?.addEventListener("click", (event) => {
    const zoomBtn = event.target.closest(".project-overlay__zoom");
    if (!zoomBtn) return;
    event.preventDefault();
    event.stopPropagation();
    const index = Number.parseInt(zoomBtn.dataset.lightboxIndex ?? "", 10);
    if (Number.isNaN(index)) return;
    void openProjectLightbox(index);
  });

