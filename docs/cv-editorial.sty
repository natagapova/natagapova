\newcommand{\cvlink}[2]{%
  \href{#1}{\textcolor{cvtext}{\underline{#2}}}%
}

\NewDocumentCommand{\cvweblinkru}{m}{\cvlink{#1}{#1}}
\NewDocumentCommand{\cvweblinken}{m}{\cvlink{#1}{#1}}

