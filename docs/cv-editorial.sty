}

\NewDocumentCommand{\cvcontactsgit}{O{Email}}{%
  \cvcontactsbase[#1] \enspace·\enspace
  \href{https://github.com/natagapova}{GitHub}%
}

\NewDocumentCommand{\cvcontactsbasescholar}{O{Email}}{%
  \cvcontactsbase[#1] \enspace·\enspace \cvscholar
}

\NewDocumentCommand{\cvcontactsgitscholar}{O{Email}}{%
  \cvcontactsbase[#1] \enspace·\enspace
  \cvscholar \enspace·\enspace
  \href{https://github.com/natagapova}{GitHub}%
}

\setlength{\parindent}{0pt}
\setlength{\parskip}{0pt}

\setlist[itemize]{leftmargin=1.1em,itemsep=0.12em,topsep=0.15em,parsep=0pt,label=\textcolor{cvlight}{\textbullet}}

\newif\ifcvprojectfirst
\cvprojectfirsttrue

\newif\ifcvneedssectiontop
\cvneedssectiontopfalse

\newif\ifcvrussian
\newcommand{\cvrussianon}{\cvrussiantrue}

\newcommand{\cvtitlewidth}{0.64\linewidth}
\newcommand{\cvtagwidth}{0.34\linewidth}
\newcommand{\cvjobtitlewidth}{0.74\linewidth}
\newcommand{\cvjobdatewidth}{0.24\linewidth}

\newcommand{\cvsection}[1]{%
  \cvprojectfirsttrue
  \cvneedssectiontoptrue
  \addvspace{1em}%
  \noindent
  {\fontsize{7.5}{8.8}\selectfont\bfseries\textcolor{cvmuted}{\MakeUppercase{#1}}\par}%
  \vspace{0.06em}%
  \noindent{\color{cvline}\rule{\linewidth}{0.4pt}}%
  \vspace{0.08em}%
}

\newcommand{\cvheader}[3]{%
  {\fontsize{21}{25}\selectfont\bfseries\color{cvtext}#1\par}%
  \vspace{0.18em}%
  {\fontsize{10.5}{13}\selectfont\color{cvmuted}#2\par}%
  \vspace{0.38em}%
  {\fontsize{8.8}{11.5}\selectfont\color{cvlight}#3\par}%
  \vspace{0.55em}%
  {\color{cvline}\rule{\linewidth}{0.4pt}}%
  \vspace{0.48em}%
}

\newcommand{\cvsummary}[1]{%
  {\fontsize{10}{14}\selectfont\color{cvtext}#1\par}%
  \vspace{0.35em}%
}

\newcommand{\cvbody}[1]{%
  \ifcvneedssectiontop
    \cvneedssectiontopfalse
  \fi
  {\fontsize{9.6}{13.4}\selectfont\color{cvtext}#1\par}%
  \vspace{0.28em}%
}

\newcommand{\cvmutedbody}[1]{%
  {\fontsize{9.2}{12.8}\selectfont\color{cvmuted}#1\par}%
  \vspace{0.22em}%
}

\newcommand{\cvfooter}[1]{%
  \vspace{0.9em}%
  \begin{center}
    {\fontsize{7.5}{9.5}\selectfont\color{cvlight}#1}
  \end{center}%
}

\newcommand{\cvskills}[1]{\cvmutedbody{\textbf{Tools:} #1}}
\newcommand{\cvskillsru}[1]{\cvmutedbody{\textbf{Инструменты:} #1}}

\NewDocumentEnvironment{cvjob}{m m}{%
  \ifcvneedssectiontop
    \cvneedssectiontopfalse
  \else
    \vspace{0.12em}%
  \fi
  \noindent
  \begin{minipage}[t]{\cvjobtitlewidth}
    {\fontsize{9.8}{12}\selectfont\bfseries\color{cvtext}#1}%
  \end{minipage}\hfill
  \begin{minipage}[t]{\cvjobdatewidth}
    \raggedleft{\fontsize{8.3}{10}\selectfont\color{cvlight}#2}%
  \end{minipage}%
  \par\vspace{0.18em}%
  \begingroup\fontsize{9.4}{13}\selectfont\color{cvtext}%
}{%
  \par\endgroup\vspace{0.1em}%
}

\NewDocumentEnvironment{cvproject}{m m}{%
  \ifcvprojectfirst
    \cvprojectfirstfalse
    \ifcvneedssectiontop
      \cvneedssectiontopfalse
    \fi
  \else
    \vspace{0.55em}%
    {\color{cvline}\rule{\linewidth}{0.35pt}}%
    \vspace{0.45em}%
  \fi
  \noindent
  \begin{minipage}[t]{\cvtitlewidth}
    {\fontsize{9.9}{12}\selectfont\bfseries\color{cvtext}#1}%
  \end{minipage}\hfill
  \begin{minipage}[t]{\cvtagwidth}
    \raggedleft{\fontsize{7.8}{10.2}\selectfont\color{cvlight}#2}%
  \end{minipage}%
  \par\vspace{0.2em}%
  \begingroup\fontsize{9.2}{12.8}\selectfont\color{cvtext}%
}{%
  \par\endgroup
  \vspace{0.15em}%
}

\newcommand{\cvthumb}[2]{%
  \includegraphics[width=#1,height=2.55cm,keepaspectratio]{#2}%
}

\newcommand{\cvgridfour}[4]{%
  \begingroup
  \setlength{\fboxsep}{5pt}%
  \noindent
  \fcolorbox{cvline}{cvfill}{%
    \begin{minipage}[t]{\linewidth}
      \centering
      \cvthumb{0.475\linewidth}{#1}\hfill
      \cvthumb{0.475\linewidth}{#2}\\[5pt]
      \cvthumb{0.475\linewidth}{#3}\hfill
      \cvthumb{0.475\linewidth}{#4}%
    \end{minipage}%
  }%
  \par
  \endgroup
}

\newcommand{\cvstripthree}[3]{%
  \begingroup
  \setlength{\fboxsep}{4pt}%
  \noindent
  \fcolorbox{cvline}{cvfill}{%
    \begin{minipage}[t]{\linewidth}
      \centering
      \cvthumb{0.31\linewidth}{#1}\hfill
      \cvthumb{0.31\linewidth}{#2}\hfill
      \cvthumb{0.31\linewidth}{#3}%
    \end{minipage}%
  }%
  \par
  \endgroup
}
