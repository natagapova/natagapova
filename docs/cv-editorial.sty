\ProvidesPackage{cv-editorial}[2026/08/28 Professional CV layout]

\RequirePackage{xcolor}
\RequirePackage{enumitem}
\RequirePackage{graphicx}
\RequirePackage{microtype}
\RequirePackage{xparse}

\definecolor{cvtext}{HTML}{1C1C1E}
\definecolor{cvmuted}{HTML}{636366}
\definecolor{cvlight}{HTML}{8E8E93}
\definecolor{cvline}{HTML}{E5E5EA}
\definecolor{cvfill}{HTML}{F9F9FB}
\definecolor{cvaccent}{HTML}{007AFF}

\newcommand{\cvwebsite}{%
  \href{https://www.natagapova.ru}{\textcolor{cvaccent}{\bfseries natagapova.ru}}%
}

\newcommand{\cvscholar}{%
  \href{https://scholar.google.com/citations?user=FqdPM_gAAAAJ}{Google Scholar}%
}

\newcommand{\cvweblinkru}[1]{\href{#1}{ссылка}}
\newcommand{\cvweblinken}[1]{\href{#1}{link}}

\NewDocumentCommand{\cvcontactsbase}{O{Email}}{%
  \cvwebsite \enspace·\enspace
  \href{https://t.me/nhefy}{Telegram} \enspace·\enspace
