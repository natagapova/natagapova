\definecolor{cvmuted}{HTML}{636366}
\definecolor{cvlight}{HTML}{8E8E93}
\definecolor{cvline}{HTML}{E5E5EA}
\definecolor{cvfill}{HTML}{F9F9FB}
\definecolor{cvaccent}{HTML}{007AFF}

