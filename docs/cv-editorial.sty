}

\NewDocumentCommand{\cvcontactsbasescholar}{O{Email}}{%
  \cvcontactsbase[#1] \enspace·\enspace \cvscholar
}

\NewDocumentCommand{\cvcontactsgitscholar}{O{Email}}{%
  \cvcontactsbase[#1] \enspace·\enspace
  \cvscholar \enspace·\enspace
