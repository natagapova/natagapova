\ProvidesPackage{cv-simple}[2026/03/21 Simple CV resume template]

\RequirePackage{titlesec}
\RequirePackage{enumitem}
\RequirePackage{xcolor}
\RequirePackage{etoolbox}
\RequirePackage{microtype}
\RequirePackage[hidelinks]{hyperref}

\definecolor{cvaccent}{RGB}{31,78,95}
\definecolor{cvgray}{RGB}{85,85,85}

\setlength{\parindent}{0pt}
\raggedright
\pagestyle{empty}

% Section titles: tracked uppercase accent color + thin rule
\newcommand{\cvsechead}[1]{\textls[140]{\MakeUppercase{#1}}}
\titleformat{\section}{\color{cvaccent}\bfseries\scriptsize}{}{0em}%
  {\cvsechead}[\vspace{1pt}{\color{cvaccent}\titlerule[0.6pt]}]
\titlespacing*{\section}{0pt}{11pt}{4pt}

\newcommand{\cvmeta}[1]{{\color{cvgray}\itshape\small #1}}

\newcommand{\resumeItem}[1]{\item{\small #1}}

% Args: title, right (date/tags), org (gray, after title), extra right tags
\newcommand{\resumeSubheading}[4]{%
  \item[]\vspace{4pt}%
  \noindent\textbf{#1}%
  \ifstrempty{#3}{}{\,{\color{cvgray}\enspace·\enspace #3}}%
  \hfill
  \ifstrempty{#2}{\cvmeta{#4}}{\ifstrempty{#4}{\cvmeta{#2}}{\cvmeta{#2\,·\,#4}}}%
  \par\nobreak\vspace{1pt}%
}

\newcommand{\resumeSubItem}[1]{\resumeItem{#1}}

\newcommand{\resumeSubHeadingListStart}{\begin{itemize}[leftmargin=0pt, label={}, itemsep=0pt, topsep=0pt, parsep=0pt]}
\newcommand{\resumeSubHeadingListEnd}{\end{itemize}}
\newcommand{\resumeItemListStart}{\begin{itemize}[leftmargin=1.6em, label={\raisebox{0.15ex}{\tiny$\bullet$}}, itemsep=1pt, topsep=1pt, parsep=0pt]}
\newcommand{\resumeItemListEnd}{\end{itemize}}

\newcommand{\cvname}[2]{%
  {\color{cvaccent}\fontsize{22}{26}\selectfont\bfseries #1}\par
  \vspace{1pt}{\color{cvgray}\large #2}\par
  \vspace{4pt}%
}

\newcommand{\cvcontacts}[1]{%
  {\color{cvgray}\footnotesize #1}\par\vspace{7pt}%
}

\newcommand{\cvsummary}[1]{%
  {\small #1}\par\vspace{2pt}%
}

\newcommand{\cvskillsblock}[1]{{\small #1}\par}

\newcommand{\cvpublication}[3]{%
  {\small #1. \textit{#2}\enspace{\color{cvgray}\href{https://doi.org/#3}{doi:#3}}}\par\vspace{3pt}%
}

% Recommendation letter / portfolio links
\newcommand{\cvlink}[2]{\href{#1}{\textit{#2}}}
\newcommand{\cvletter}[2]{\resumeItem{\href{#1}{\textcolor{cvaccent}{\textit{#2}}\,$\rightarrow$}}}

