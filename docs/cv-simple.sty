\ProvidesPackage{cv-simple}[2026/10/08 Classic black-and-white CV template]

\RequirePackage{titlesec}
\RequirePackage{enumitem}
\RequirePackage{tabularx}
\RequirePackage{xcolor}
\RequirePackage{etoolbox}
\RequirePackage{microtype}
\RequirePackage[hidelinks]{hyperref}

\definecolor{cvaccent}{RGB}{31,78,95}
\definecolor{cvgray}{RGB}{90,90,90}

\setlength{\parindent}{0pt}
\raggedright
\pagestyle{empty}

% Section titles: small caps, bold, full-width rule -- plain black
\newcommand{\cvsechead}[1]{\scshape\bfseries #1}
\titleformat{\section}{\bfseries}{}{0em}%
  {\cvsechead}[\vspace{2pt}{\titlerule[0.8pt]}]
\titlespacing*{\section}{0pt}{3pt}{5pt}

\newcommand{\cvmeta}[1]{{\color{cvgray}\itshape\small #1}}

\newcommand{\resumeItem}[1]{\item{\small #1}}

% Three-column job/education header: title (left) -- org (center, bold) -- dates (right)
% Args: #1 title, #2 dates, #3 org, #4 unused (kept for call-site compatibility)
\newcommand{\resumeSubheading}[4]{%
  \item[]\vspace{1pt}%
  \noindent\begin{tabularx}{\linewidth}{%
    @{}>{\raggedright\arraybackslash}p{0.34\linewidth}%
    >{\centering\arraybackslash}X%
    >{\raggedleft\arraybackslash}p{0.26\linewidth}@{}%
  }
    \textbf{#1} & \textbf{#3} & #2 \\
  \end{tabularx}\par\nobreak\vspace{1pt}%
}

% Plain entry (no org column) -- used for projects: title (left) -- tags/link (right)
\newcommand{\resumeProject}[2]{%
  \item[]\vspace{1pt}%
  \noindent\textbf{#1}\hfill{\small #2}\par\nobreak\vspace{1pt}%
}

\newcommand{\resumeSubItem}[1]{\resumeItem{#1}}

% Nested role list, for showing multiple titles held at one company.
% Use resumeProject{Company}{dates} as the company header, then wrap each
% role in resumeRoleListStart/End with a \resumeRole{title}{dates} heading.
\newcommand{\resumeRoleListStart}{\begin{itemize}[leftmargin=0.9em, label={}, itemsep=1pt, topsep=0pt, parsep=0pt]}
\newcommand{\resumeRoleListEnd}{\end{itemize}}
\newcommand{\resumeRole}[2]{%
  \item[]\noindent{\small\itshape #1}\hfill{\small\itshape #2}\par\nobreak%
}

% Bolded, underlined lead-in bullet for the tools/tech line, e.g.
% "Leveraged knowledge in Python, PyTorch, ..." or "Utilized: React, Next.js, ..."
\newcommand{\cvtech}[2]{\item{\small \textbf{#1}#2}}

\newcommand{\resumeSubHeadingListStart}{\begin{itemize}[leftmargin=0pt, label={}, itemsep=0pt, topsep=0pt, parsep=0pt]}
\newcommand{\resumeSubHeadingListEnd}{\end{itemize}}
\newcommand{\resumeItemListStart}{\begin{itemize}[leftmargin=1.4em, label={\small -}, itemsep=0pt, topsep=0pt, parsep=0pt]}
\newcommand{\resumeItemListEnd}{\end{itemize}}

% ---------- Header: name centered, contacts in four corners ----------
\newcommand{\cvname}[2]{%
  \begin{center}
    {\Large\bfseries\scshape #1}\par
    \vspace{1pt}{\large #2}
  \end{center}
  \vspace{1pt}%
}

% #1 = top-left, #2 = top-right, #3 = bottom-left, #4 = bottom-right
\newcommand{\cvcontactsgrid}[4]{%
  \noindent
  \begin{tabularx}{\linewidth}{@{}X >{\raggedleft\arraybackslash}X@{}}
    {\small #1} & {\small #2} \\
    {\small #3} & {\small #4} \\
  \end{tabularx}
  \par\vspace{2pt}%
}

\newcommand{\cvcontacts}[1]{%
  {\color{cvgray}\footnotesize #1}\par\vspace{5pt}%
}

\newcommand{\cvsummary}[1]{%
  {\small #1}\par\vspace{1pt}%
}

\newcommand{\cvskillsblock}[1]{{\small #1}\par}

\newcommand{\cvpublication}[3]{%
  {\small #1. \textit{#2}\enspace{\color{cvgray}\href{https://doi.org/#3}{doi:#3}}}\par%
}

% Recommendation letter / portfolio links
\newcommand{\cvlink}[2]{\href{#1}{\textit{#2}}}
\newcommand{\cvletter}[2]{\resumeItem{\href{#1}{\underline{\textit{#2}}}\,$\rightarrow$}}

